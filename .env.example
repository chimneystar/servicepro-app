# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. Never expose to the client. Required for payment/webhook routes
# and the daily cron job (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- App URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (online invoice payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Helcim connected payments ---
# Issued by Helcim after partner approval. Keep every value server-only.
HELCIM_PARTNER_TOKEN=
HELCIM_CONNECTED_WEBHOOK_VERIFIER=
HELCIM_PAYMENT_WEBHOOK_VERIFIER=

# Encrypts merchant credentials stored in Supabase. Generate a strong random
# value once per environment and do not rotate it without re-encrypting data.
PAYMENT_SECRETS_KEY=

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Resend (transactional email) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Misc ---
# REQUIRED. Shared secret checked by app/api/cron/daily/route.ts. Without it the
# daily cron returns 401 and does nothing, so reminders, payment reconciliation
# and data retention all stop. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
