# Existing Supabase variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only integration encryption (32 random bytes, base64 encoded)
INTEGRATION_ENCRYPTION_KEY=

# Gmail OAuth and Pub/Sub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Twilio ISV primary account
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Stripe Connect platform
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Cron authentication; Vercel supplies this header to cron requests
CRON_SECRET=

# Production fallback; previews use VERCEL_URL automatically
NEXT_PUBLIC_APP_URL=
