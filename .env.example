# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. Never expose to the client. Required for Stripe/Twilio webhooks
# and the daily cron job (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- App URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (online invoice payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Resend (transactional email) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Misc ---
# Shared secret checked by app/api/cron/daily/route.ts to authorize the cron trigger.
CRON_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
