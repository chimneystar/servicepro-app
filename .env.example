# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. Never expose to the client. Required for payment/webhook routes
# and the daily cron job (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- App URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (online invoice payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Helcim connected payments ---
# Issued by Helcim after partner approval. Keep every value server-only.
HELCIM_PARTNER_TOKEN=
HELCIM_CONNECTED_WEBHOOK_VERIFIER=
HELCIM_PAYMENT_WEBHOOK_VERIFIER=

# Encrypts merchant credentials stored in Supabase. 32 bytes, hex or base64:
#   node -e "console.log('hex:'+require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_SECRETS_KEY=
# Which key version PAYMENT_SECRETS_KEY IS. Existing rows all say 1, so leave
# this at 1 until the first rotation, then increment it with the new key.
PAYMENT_SECRETS_KEY_VERSION=
# Retired keys still needed to READ tokens that have not been re-encrypted yet,
# as "<version>:<key>" pairs: "1:hex:abc...,2:hex:def...". Only set during a
# rotation; clear it once /admin > Encryption keys reports every record on the
# active version. Rotation is run from /admin and is recorded in
# secret_key_rotations. See lib/core/secret-keyring.mjs for the exact sequence.
PAYMENT_SECRETS_KEYS=

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Resend (transactional email) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Web Push (technician notifications) ---
# Without these three the app still ENROLS devices, but nothing can be
# delivered — and it now says so on screen instead of failing silently.
# Generate a pair once per environment (no npm install needed):
#   node -e "const c=require('crypto');const k=c.createECDH('prime256v1');k.generateKeys();console.log('NEXT_PUBLIC_VAPID_PUBLIC_KEY='+k.getPublicKey().toString('base64url'));console.log('VAPID_PRIVATE_KEY='+k.getPrivateKey().toString('base64url'))"
# The public key is deliberately NEXT_PUBLIC_ — the browser needs it to
# subscribe. The private key is server-only and must never be committed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services, e.g. mailto:ops@yourbusiness.com
VAPID_SUBJECT=

# --- Misc ---
# REQUIRED. Shared secret checked by app/api/cron/daily/route.ts. Without it the
# daily cron returns 401 and does nothing, so reminders, payment reconciliation
# and data retention all stop. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
